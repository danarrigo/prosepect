:80 {
    encode zstd gzip

    handle /api/* {
        reverse_proxy api:3000
    }

    handle /api-doc/* {
        reverse_proxy api:3000
    }

    handle /docs* {
        reverse_proxy api:3000
    }

    handle /health {
        reverse_proxy api:3000
    }

    handle /ready {
        reverse_proxy api:3000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
