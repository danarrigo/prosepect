(app_routes) {
    encode zstd gzip
    @backend path /api/* /api-doc/* /docs* /health /ready /webhooks/google/calendar
    handle @backend {
        reverse_proxy api:3000 {
            # Backend uses the FIRST XFF value. Never accept a caller's chain.
            header_up X-Forwarded-For {remote_host}
            header_up -X-Real-IP
            header_up X-Forwarded-Proto https
        }
    }
    handle {
        header {
            Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
            X-Frame-Options DENY
            X-Content-Type-Options nosniff
            Referrer-Policy strict-origin-when-cross-origin
        }
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

:8081 {
    bind 0.0.0.0
    respond /health 200
}
