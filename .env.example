# Runtime
APP_ENV=development
BIND_ADDRESS=0.0.0.0:3000
RUST_LOG=prosepect_api=debug,tower_http=info

# PostgreSQL
DATABASE_URL=postgres://prosepect:prosepect@localhost:5432/prosepect
DATABASE_MAX_CONNECTIONS=10

# Browser access
CORS_ALLOWED_ORIGIN=http://localhost:5173
ALLOW_INSECURE_DEV_AUTH=true

# Reserved for integration milestones
MONGODB_URI=mongodb://localhost:27017/prosepect
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=prosepect
S3_ACCESS_KEY=prosepect
S3_SECRET_KEY=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
